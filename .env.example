# Base de datos PostgreSQL (Neon)
DATABASE_URL=postgres://user:password@host/dbname

# NextAuth v4
NEXTAUTH_SECRET=generate-with-`openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3000

# Token opcional para crear el primer administrador (A1)
# - Déjalo vacío en producción si el primer usuario debe ser normal (fail-closed).
# - Con valor: la primera cuenta creada (solo si SETUP_TOKEN coincide) será ADMIN.
SETUP_TOKEN=

# Si es 'true', el login muestra el campo "setup code" para el primer admin.
# Recomendado: dejarlo vacío en producción salvo durante el bootstrap inicial.
NEXT_PUBLIC_SETUP_TOKEN_REQUIRED=false

# Cloudflare Turnstile (opcional pero recomendado)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Pasarela de Pagos Stripe
# Obtén tus claves en https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
# Clave del Webhook obtenida con `stripe listen --forward-to localhost:3000/api/webhooks/stripe` o Dashboard
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Pasarela de Pagos PayPal
# Obtén tus credenciales en https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 'sandbox' para pruebas, 'live' para producción real
PAYPAL_MODE=sandbox
# ID del webhook configurado en PayPal Dashboard (apunta a /api/webhooks/paypal)
PAYPAL_WEBHOOK_ID=