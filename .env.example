# Base de datos PostgreSQL (Neon)
DATABASE_URL=postgres://user:password@host/dbname

# NextAuth v4
NEXTAUTH_SECRET=generate-with-`openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3000

# Token opcional para crear el primer administrador (A1)
# - Déjalo vacío en producción si el primer usuario debe ser normal (fail-closed).
# - Con valor: la primera cuenta creada (solo si SETUP_TOKEN coincide) será ADMIN.
SETUP_TOKEN=

# Si es 'true', el login muestra el campo "setup code" para el primer admin.
# Recomendado: dejarlo vacío en producción salvo durante el bootstrap inicial.
NEXT_PUBLIC_SETUP_TOKEN_REQUIRED=false

# Cloudflare Turnstile (opcional pero recomendado)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=